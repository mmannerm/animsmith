crates/animsmith/testdata/collection-spike/*.md text eol=lf
crates/animsmith/testdata/collection-spike/*.toml text eol=lf
crates/animsmith/testdata/collection-spike/source/*.gltf text eol=lf
.agents/skills/evaluate-animation-packs/fixtures/*.json text eol=lf
docs/site/fonts/*.woff2 binary
docs/site/*.png binary
# The report embeds these files byte for byte (include_str!), so every checkout
# must hold the same bytes: a CRLF checkout would change every generated document.
crates/animsmith-report/assets/* text eol=lf
# The documentation visuals are compared byte for byte against the generator
# output, which writes LF.
docs/visuals/** text eol=lf
# The isolated Bevy probe hashes its own lock byte for byte (include_bytes!),
# and `just bevy-readback-lock` compares the engine's copy of that identity
# byte for byte, so both must survive every checkout unchanged.
tools/bevy-readback/Cargo.lock text eol=lf
crates/animsmith-engine/src/bevy_readback_lock.txt text eol=lf
