{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animsmith:schema:producer-refusal:1",
  "title": "animsmith producer refusal v1",
  "description": "Machine-readable asset-property refusal emitted by an artifact producer with --format json.",
  "type": "object",
  "required": ["schema_version", "schema", "tool", "command", "outcome", "result", "rejection"],
  "properties": {
    "schema_version": { "const": 1 },
    "schema": { "const": "urn:animsmith:schema:producer-refusal:1" },
    "tool": { "$ref": "#/$defs/tool" },
    "command": { "enum": ["convert", "assemble", "contact-fragment", "collection-transform-foot-cycle"] },
    "outcome": { "const": "rejected" },
    "result": { "type": "null" },
    "rejection": { "$ref": "#/$defs/rejection" }
  },
  "additionalProperties": false,
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version", "source"],
      "properties": {
        "name": { "const": "animsmith" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "source": {
          "type": "object",
          "required": ["revision", "dirty"],
          "properties": {
            "revision": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
            "dirty": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rejection": {
      "type": "object",
      "required": ["stage", "kind", "detail"],
      "properties": {
        "stage": { "enum": ["load", "selection", "analysis", "transform", "proof", "encode"] },
        "kind": { "enum": ["unreadable-source", "unsupported-source-domain", "invalid-asset-structure", "asset-recipe-mismatch", "transform-refused", "proof-failed", "unrepresentable-artifact", "incomplete-evidence", "selection-mismatch"] },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
