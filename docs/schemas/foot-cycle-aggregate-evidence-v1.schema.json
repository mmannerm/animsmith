{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animsmith:schema:foot-cycle-aggregate-evidence:1",
  "title": "AnimSmith foot-cycle aggregate evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "tool", "command", "outcome", "manifest_input", "parameterization_input", "runtime_set_id", "reference_member", "proof_policy", "gait_phase_spread", "members", "resources"],
  "properties": {
    "schema": {"const": "urn:animsmith:schema:foot-cycle-aggregate-evidence:1"},
    "schema_version": {"const": 1},
    "tool": {"$ref": "urn:animsmith:schema:foot-cycle-member-evidence:1#/$defs/tool"},
    "command": {"const": "collection-transform-foot-cycle"},
    "outcome": {"const": "published"},
    "manifest_input": {"$ref": "urn:animsmith:schema:foot-cycle-member-evidence:1#/$defs/identity"},
    "parameterization_input": {"$ref": "urn:animsmith:schema:foot-cycle-member-evidence:1#/$defs/identity"},
    "runtime_set_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "reference_member": {"type": "string", "minLength": 1, "maxLength": 255},
