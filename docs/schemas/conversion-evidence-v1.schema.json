{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animsmith:schema:conversion-evidence:1",
  "title": "animsmith conversion evidence v1",
  "description": "Machine-readable evidence emitted by animsmith convert --format json.",
  "type": "object",
  "required": ["schema_version", "schema", "tool", "command", "input", "output", "options", "artifact"],
  "properties": {
    "schema_version": { "const": 1 },
    "schema": { "const": "urn:animsmith:schema:conversion-evidence:1" },
    "tool": { "$ref": "#/$defs/tool" },
    "command": { "const": "convert" },
    "input": { "type": "string" },
    "output": { "type": "string" },
    "options": { "$ref": "#/$defs/options" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "static_mesh_bake": { "$ref": "#/$defs/static_mesh_bake" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "options": {
            "properties": {
              "bake_static_mesh_transforms": { "const": true }
            },
            "required": ["bake_static_mesh_transforms"]
          }
        },
        "required": ["options"]
      },
      "then": { "required": ["static_mesh_bake"] },
      "else": { "not": { "required": ["static_mesh_bake"] } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version", "source"],
      "properties": {
        "name": { "const": "animsmith" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "source": {
          "type": "object",
          "required": ["revision", "dirty"],
          "properties": {
            "revision": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
            "dirty": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "required": ["animation_only", "bake_static_mesh_transforms"],
      "properties": {
        "animation_only": { "type": "boolean" },
        "bake_static_mesh_transforms": { "type": "boolean" }
      },
      "not": {
        "properties": {
          "animation_only": { "const": true },
          "bake_static_mesh_transforms": { "const": true }
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["nodes", "animations", "meshes", "primitive_positions", "materials", "clips_without_writable_tracks"],
      "properties": {
        "nodes": { "type": "integer", "minimum": 0 },
        "animations": { "type": "integer", "minimum": 0 },
        "meshes": { "type": "integer", "minimum": 0 },
        "primitive_positions": { "type": "integer", "minimum": 0 },
        "materials": { "type": "integer", "minimum": 0 },
        "clips_without_writable_tracks": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "static_mesh_bake": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/static_mesh_bake_entry" }
        }
      },
      "additionalProperties": false
    },
    "static_mesh_bake_entry": {
      "type": "object",
      "required": ["source_node_index", "source_node_name", "source_mesh_ordinal", "source_mesh_index", "source_mesh_name", "output_node_index", "output_mesh_index", "world_transform", "linear_determinant", "primitive_count", "position_count", "normal_count"],
      "properties": {
        "source_node_index": { "type": "integer", "minimum": 0 },
        "source_node_name": { "type": "string" },
        "source_mesh_ordinal": { "type": "integer", "minimum": 0 },
        "source_mesh_index": { "type": "integer", "minimum": 0 },
        "source_mesh_name": { "type": "string" },
        "output_node_index": { "type": "integer", "minimum": 0 },
        "output_mesh_index": { "type": "integer", "minimum": 0 },
        "world_transform": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 16,
          "maxItems": 16
        },
        "linear_determinant": { "type": "number" },
        "primitive_count": { "type": "integer", "minimum": 0 },
        "position_count": { "type": "integer", "minimum": 0 },
        "normal_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
